# PostgreSQL database configuration for Docker Compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_DB=assetflow
DB_PORT=5432

# Cloudinary credentials for image upload
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# JWT Authentication Config
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=1d

# Ports for application services
BACKEND_PORT=4000
FRONTEND_PORT=3000
PGADMIN_PORT=5050

# Seed script credentials (frontend/prisma/seed.ts aborts if these are missing).
# The roster itself lives in frontend/prisma/employees.csv, which is NOT in git.
# Copy frontend/prisma/employees.example.csv to employees.csv to get started.
SEED_DEFAULT_PASSWORD=choose-a-strong-default-password
SEED_ADMIN_PASSWORD=choose-a-strong-admin-password
